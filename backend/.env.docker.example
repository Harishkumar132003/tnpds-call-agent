# Overrides applied on top of backend/.env when running under docker compose.
# Inside a container "localhost" is the container itself, so point at the
# services by name (same docker network) or at the host gateway.

# Postgres runs as the `local-postgres` container on shared-app-network:
DATABASE_URL=postgresql://USER:PASSWORD@local-postgres:5432/voice_agent

# Qdrant publishes 6333 on the host. Use the host gateway, or `http://qdrant:6333`
# after `docker network connect shared-app-network qdrant`.
QDRANT_URL=http://host.docker.internal:6333

PORTAL_HOST=0.0.0.0

# Phone deployment: Plivo reaches the bot at wss://<PUBLIC_HOST>/ws through nginx
PUBLIC_HOST=callagent.wizzgeeks.com
# Leave BOT_TRANSPORT unset so one container takes Plivo calls on /ws and browser
# test calls (portal → Test call) over WebRTC. Set it to plivo to switch WebRTC off.
#BOT_TRANSPORT=plivo
# Where a browser reaches the bot for test calls
BOT_PUBLIC_URL=https://callagent.wizzgeeks.com

# Langfuse runs on the same docker network, so the bot talks to it by container name
# (same project and keys as LANGFUSE_HOST=https://langfuse.wizzgeeks.com on a laptop)
LANGFUSE_HOST=http://langfuse-web:7310
