# --- Sarvam AI (required) -------------------------------------------------
# Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Conversation language ------------------------------------------------
# Sarvam language code used for TTS and (unless auto-detecting) STT.
# Supported: hi-IN, en-IN, bn-IN, gu-IN, kn-IN, ml-IN, mr-IN, od-IN, pa-IN, ta-IN, te-IN
AGENT_LANGUAGE=hi-IN
# When true, STT auto-detects the spoken language instead of being pinned
# to AGENT_LANGUAGE. TTS still speaks AGENT_LANGUAGE.
STT_AUTO_DETECT_LANGUAGE=false

# --- Sarvam speech models -------------------------------------------------
SARVAM_STT_MODEL=saaras:v4
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
# Leave empty for the model default speaker. bulbul:v3 speakers include
# shubh, priya, neha, rahul, pooja, kavya, amit, ... (see README)
SARVAM_TTS_SPEAKER=
# Speech pace. bulbul:v3 accepts 0.5 - 2.0 (bulbul:v2: 0.3 - 3.0)
SARVAM_TTS_PACE=1.0

# --- LLM ------------------------------------------------------------------
# sarvam : Sarvam's OpenAI-compatible chat API (uses SARVAM_API_KEY)
# openai : any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter, ...)
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b
# Sarvam's reasoning models think before answering, adding 1-2 s to every reply.
# none | low | medium | high | empty (provider default). "none" measured ~0.3 s to first word.
LLM_REASONING_EFFORT=none
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional; set for non-OpenAI providers, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# --- Deployment -----------------------------------------------------------
# Public hostname Plivo reaches the bot through (wss://<host>/ws). Used as the
# runner's --proxy when the flag is not given, so `python bot.py` needs no args.
PUBLIC_HOST=
# Transport to start with when -t is not given: plivo for phone deployments,
# empty for local development (all transports, including the WebRTC test page).
BOT_TRANSPORT=

# --- Plivo telephony (optional, phase 4) ----------------------------------
# From https://console.plivo.com. Also read by the Pipecat runner for hang-up.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number (caller ID for outbound test calls), digits only or E.164
PLIVO_FROM_NUMBER=
# Phone to ring with scripts/plivo_call.py, E.164 e.g. +919876543210
MOBILE_NUMBER=

# --- Agent behaviour ------------------------------------------------------
AGENT_NAME=Asha
# Optional: override the default system prompt entirely.
# AGENT_SYSTEM_PROMPT=
# Optional: a fixed opening line in AGENT_LANGUAGE, spoken instantly through TTS
# instead of waiting for the LLM to compose a greeting (saves 1-2 s per call).
# AGENT_GREETING=வணக்கம், நான் ஆஷா. நான் உங்களுக்கு எப்படி உதவலாம்?

# --- Call tracking + portal (optional) ------------------------------------
# When set, the agent records every call/turn with latencies and applies the
# prompt/temperature saved in the portal. Leave empty to disable.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/voice_agent
# 127.0.0.1 for local use; 0.0.0.0 when running in Docker / behind a reverse proxy
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8090

# --- Knowledge base (portal document uploads) ------------------------------
# Embeddings use OPENAI_API_KEY above with OpenAI's multilingual embedding model.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voice_agent_knowledge
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=200

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
# Seconds of no user/bot activity before a session is closed.
SESSION_IDLE_TIMEOUT_SECS=300

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
