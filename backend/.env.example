# --- Sarvam AI (required) -------------------------------------------------
# Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Conversation language ------------------------------------------------
# Sarvam language code used for TTS and (unless auto-detecting) STT.
# Supported: hi-IN, en-IN, bn-IN, gu-IN, kn-IN, ml-IN, mr-IN, od-IN, pa-IN, ta-IN, te-IN
AGENT_LANGUAGE=hi-IN
# When true, STT auto-detects the spoken language instead of being pinned
# to AGENT_LANGUAGE. TTS still speaks AGENT_LANGUAGE.
STT_AUTO_DETECT_LANGUAGE=false

# --- Sarvam speech models -------------------------------------------------
SARVAM_STT_MODEL=saaras:v4
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
# Leave empty for the model default speaker. bulbul:v3 speakers include
# shubh, priya, neha, rahul, pooja, kavya, amit, ... (see README)
# Translation model for knowledge-base queries: mayura:v1 (default, colloquial mode) or sarvam-translate:v1
TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_SPEAKER=
# Speech pace. bulbul:v3 accepts 0.5 - 2.0 (bulbul:v2: 0.3 - 3.0)
SARVAM_TTS_PACE=1.0

# --- LLM ------------------------------------------------------------------
# sarvam : Sarvam's OpenAI-compatible chat API (uses SARVAM_API_KEY)
# openai : any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter, ...)
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b
# Sarvam's reasoning models think before answering, adding 1-2 s to every reply.
# none | low | medium | high | empty (provider default). "none" measured ~0.3 s to first word.
LLM_REASONING_EFFORT=none
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional; set for non-OpenAI providers, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# --- Deployment -----------------------------------------------------------
# Public hostname Plivo reaches the bot through (wss://<host>/ws). Used as the
# runner's --proxy when the flag is not given, so `python bot.py` needs no args.
PUBLIC_HOST=
# Transport to start with when -t is not given: plivo for phone deployments,
# empty for local development (all transports, including the WebRTC test page).
BOT_TRANSPORT=

# --- Plivo telephony (optional, phase 4) ----------------------------------
# From https://console.plivo.com. Also read by the Pipecat runner for hang-up.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Your Plivo number (caller ID for outbound test calls), digits only or E.164
PLIVO_FROM_NUMBER=
# Phone to ring with scripts/plivo_call.py, E.164 e.g. +919876543210
# scripts/plivo_point.py: which Plivo application to repoint, and the server host for `prod`
PLIVO_APP_NAME=TNPDS_Custom_Development
PLIVO_PROD_HOST=callagent.wizzgeeks.com
MOBILE_NUMBER=

# --- Agent behaviour ------------------------------------------------------
AGENT_NAME=Asha
# Optional: override the default system prompt entirely.
# AGENT_SYSTEM_PROMPT=
# Optional: a fixed opening line in AGENT_LANGUAGE, spoken instantly through TTS
# instead of waiting for the LLM to compose a greeting (saves 1-2 s per call).
# AGENT_GREETING=வணக்கம், நான் ஆஷா. நான் உங்களுக்கு எப்படி உதவலாம்?

# --- Call tracking + portal (optional) ------------------------------------
# When set, the agent records every call/turn with latencies and applies the
# prompt/temperature saved in the portal. Leave empty to disable.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/voice_agent
# 127.0.0.1 for local use; 0.0.0.0 when running in Docker / behind a reverse proxy
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8090

# --- Langfuse (optional) --------------------------------------------------
# Off by default. LANGFUSE_ENABLED=true sends every call to Langfuse v2 as a
# trace with per-turn token/character/second usage (see compose.langfuse.yaml),
# provided the host and keys below are set. Inside docker use
# http://langfuse-web:3000; locally http://localhost:3100.
LANGFUSE_ENABLED=false
# The shared production Langfuse (same project from your laptop and the server):
#   LANGFUSE_HOST=https://langfuse.wizzgeeks.com
# A local instance (compose.langfuse.yaml + compose.langfuse.local.yaml): http://localhost:3100
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Knowledge base (portal document uploads) ------------------------------
# Embeddings use OPENAI_API_KEY above with OpenAI's multilingual embedding model.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voice_agent_knowledge
EMBEDDING_MODEL=text-embedding-3-small
# One uploaded document = one chunk (FAQ sheets are single topics). Documents
# over ~24k chars fall back to CHUNK_CHARS/OVERLAP splitting.
KNOWLEDGE_WHOLE_DOCUMENT=true
# How many chunks a call's search hands to the LLM.
KNOWLEDGE_TOP_K=1
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=200

# --- Idle handling --------------------------------------------------------
# After the agent finishes speaking, if the caller stays silent this long the
# agent asks once "are you still there?"; the same silence again ends the call
# (and hangs up on Plivo). 0 disables. Lines default per language; override here.
IDLE_PROMPT_SECS=10
# IDLE_CHECK_LINE=நீங்க லைன்ல இருக்கீங்களா?
# IDLE_GOODBYE_LINE=பதில் வரலை, அதனால call-ஐ முடிக்கிறேன். நன்றி.

# --- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
# Seconds of no user/bot activity before a session is closed.
SESSION_IDLE_TIMEOUT_SECS=300

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Bot URL the portal's Test call page connects to (browser side)
BOT_PUBLIC_URL=http://localhost:7860

# TURN relay for browser test calls from outside the server (compose.turn.yaml reads
# these through the ./.env symlink). Public IPv4 of the server, not a proxied name.
#TURN_PUBLIC_IP=1.2.3.4
#TURN_USER=voice
#TURN_PASSWORD=change-me        # openssl rand -hex 16
#TURN_REALM=wizzgeeks.com

# Knowledge search: send every sheet scoring at least KNOWLEDGE_MIN_SCORE (0.50 = 50%),
# at most KNOWLEDGE_TOP_K per question. KNOWLEDGE_KEEP_BEST=true still sends the single
# best sheet when none reaches the threshold (set false for a strict cut-off).
KNOWLEDGE_MIN_SCORE=0.50
KNOWLEDGE_TOP_K=5
KNOWLEDGE_KEEP_BEST=true
