# Settings for compose.langfuse.yaml (Langfuse v2). Copy to langfuse.env and
# change every secret. Generate values with:  openssl rand -hex 32

# Postgres database for Langfuse on the existing server Postgres (create it first):
#   dev machine:  postgresql://admin:PASSWORD@local-postgres:5432/langfuse
#   server:       postgresql://voice_agent:PASSWORD@oasys-postgres:5432/langfuse
DATABASE_URL=postgresql://USER:PASSWORD@oasys-postgres:5432/langfuse

SALT=change-me-salt
NEXTAUTH_SECRET=change-me-nextauth-secret
# The URL people open Langfuse at. Server: the nginx subdomain. Local overlay: http://localhost:3100
NEXTAUTH_URL=https://langfuse.wizzgeeks.com

# First-start bootstrap: org, project and login. The project's API keys are NOT
# here: they come from backend/.env (LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY),
# which the agent uses too, so there is one key pair to manage.
LANGFUSE_INIT_ORG_ID=wizzgeeks
LANGFUSE_INIT_ORG_NAME=Wizzgeeks
LANGFUSE_INIT_PROJECT_ID=voice-agent
LANGFUSE_INIT_PROJECT_NAME=Voice Agent
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-password
